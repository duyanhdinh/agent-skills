Table users {
  id uuid [pk]
  email text [not null, unique]
  display_name text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table posts {
  id uuid [pk]
  author_id uuid [not null, ref: > users.id]
  title text [not null]
  body text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    author_id
    created_at
  }
}
