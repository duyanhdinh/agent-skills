---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<section class="rounded-xl border border-slate-200 bg-white p-8">
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">{title}</h1>
  <p class="mt-3 text-slate-600">{description}</p>
</section>
