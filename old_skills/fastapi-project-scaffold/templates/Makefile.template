.PHONY: install dev lint format typecheck test run

install:
	pip install -e ".[dev]"

dev:
	uvicorn src.main:app --reload --host 0.0.0.0 --port 8000

lint:
	ruff check src tests

format:
	ruff check --fix src tests

typecheck:
	mypy src

test:
	pytest -q

run:
	uvicorn src.main:app --host 0.0.0.0 --port 8000
